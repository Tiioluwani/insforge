# ─── InsForge Backend ──────────────────────────────────────────────────────────
# Get these from your InsForge project dashboard → Settings → API Keys
# Self-hosted: http://localhost:7130

INSFORGE_BASE_URL=https://your-project.region.insforge.app
INSFORGE_ANON_KEY=your-anon-key-here
# Service key has elevated privileges (skip RLS). Use for server-side only.
INSFORGE_SERVICE_KEY=your-service-key-here

# ─── FastAPI ───────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
PORT=8000
