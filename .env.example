# ─── InsForge (used by @insforge/sdk in the browser for Realtime) ───────────
# Get from your InsForge project dashboard at https://insforge.dev
NEXT_PUBLIC_INSFORGE_BASE_URL=https://your-project.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-anon-key-here

# ─── FastAPI backend URL (proxied at runtime) ────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
